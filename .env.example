# Path to a local clone of the harness-engineering repository
# (the one with the skills/<slug>/SKILL.md + skills/<slug>/reference/*.md structure).
# Defaults to ~/harness-engineering if unset, or (on a fresh CI/Vercel build)
# to an auto-clone made by scripts/fetch-harness.mjs into .harness-cache/.
HARNESS_PATH=

# Only used by scripts/fetch-harness.mjs, to clone a fork/mirror instead of
# the default harness-engineering repo. Leave unset unless you need this.
HARNESS_REPO_URL=
